72,373,375],{},"Download ",[56,357,358],{},"onlinesim-\u003Ctarget>.tar.gz"," (or ",[56,361,362],{},".zip"," on Windows) from\n",[48,365,368],{"href":366,"rel":367},"https:\u002F\u002Fgithub.com\u002Fon-org\u002Fonlinesim-mcp\u002Freleases\u002Flatest",[52],"the latest release",", unpack it and put ",[56,371,58],{}," somewhere on\n",[56,374,179],{},". Check:",[136,377,379],{"className":138,"code":378,"language":140,"meta":141,"style":141},"onlinesim --version\n",[56,380,381],{"__ignoreMap":141},[145,382,383,385],{"class":147,"line":12},[145,384,58],{"class":150},[145,386,387],{"class":154}," --version\n",[131,389,391],{"id":390},"agent-skill","Agent skill",[44,393,394],{},"The skill lets the agent install the binary, start the server and ask you for the API key when needed:",[136,396,398],{"className":138,"code":397,"language":140,"meta":141,"style":141},"npx skills add on-org\u002Fonlinesim-mcp                  # this workspace\nnpx skills add on-org\u002Fonlinesim-mcp -g               # all projects\nnpx skills add on-org\u002Fonlinesim-mcp -a cursor -y     # Cursor only\n",[56,399,400,418,434],{"__ignoreMap":141},[145,401,402,405,408,411,414],{"class":147,"line":12},[145,403,404],{"class":150},"npx",[145,406,407],{"class":154}," skills",[145,409,410],{"class":154}," add",[145,412,413],{"class":154}," on-org\u002Fonlinesim-mcp",[145,415,417],{"class":416},"sHwdD","                  # this workspace\n",[145,419,420,422,424,426,428,431],{"class":147,"line":17},[145,421,404],{"class":150},[145,423,407],{"class":154},[145,425,410],{"class":154},[145,427,413],{"class":154},[145,429,430],{"class":154}," -g",[145,432,433],{"class":416},"               # all projects\n",[145,435,436,438,440,442,444,447,450,453],{"class":147,"line":22},[145,437,404],{"class":150},[145,439,407],{"class":154},[145,441,410],{"class":154},[145,443,413],{"class":154},[145,445,446],{"class":154}," -a",[145,448,449],{"class":154}," cursor",[145,451,452],{"class":154}," -y",[145,454,455],{"class":416},"     # Cursor only\n",[44,457,458,459,462,463,466],{},"Open a new agent chat. The skill runs ",[56,460,461],{},"scripts\u002Fensure-ready"," first (binary → MCP up → auth). If there is no API key,\nthe agent asks you to paste it and runs ",[56,464,465],{},"onlinesim login --apikey …",".",[44,468,469,470,477,478,481,482,466],{},"To have the rules in every Cursor chat, copy\n",[48,471,474],{"href":472,"rel":473},"https:\u002F\u002Fgithub.com\u002Fon-org\u002Fonlinesim-mcp\u002Fblob\u002Fmaster\u002Fskills\u002Fonlinesim-mcp\u002Frules\u002Fonlinesim-mcp.mdc",[52],[56,475,476],{},"skills\u002Fonlinesim-mcp\u002Frules\u002Fonlinesim-mcp.mdc","\nto ",[56,479,480],{},".cursor\u002Frules\u002F"," of your project, or paste it into ",[483,484,485],"strong",{},"Cursor → Settings → Rules → User Rules",[131,487,489],{"id":488},"after-installing","After installing",[136,491,493],{"className":138,"code":492,"language":140,"meta":141,"style":141},"onlinesim login      # paste the API key\nonlinesim doctor     # config, key and API reachability\nonlinesim mcp        # start the server\n",[56,494,495,505,515],{"__ignoreMap":141},[145,496,497,499,502],{"class":147,"line":12},[145,498,58],{"class":150},[145,500,501],{"class":154}," login",[145,503,504],{"class":416},"      # paste the API key\n",[145,506,507,509,512],{"class":147,"line":17},[145,508,58],{"class":150},[145,510,511],{"class":154}," doctor",[145,513,514],{"class":416},"     # config, key and API reachability\n",[145,516,517,519,522],{"class":147,"line":22},[145,518,58],{"class":150},[145,520,521],{"class":154}," mcp",[145,523,524],{"class":416},"        # start the server\n",[44,526,527,528,466],{},"Then ",[48,529,530],{"href":15},"connect your client",[131,532,534],{"id":533},"updates","Updates",[44,536,537,538,112,541,466],{},"The CLI checks GitHub for a newer release at most once a day and prints the update command. Run the install script\nagain to update. Turn the check off with ",[56,539,540],{},"--no-update-check",[56,542,543],{},"ONLINESIM_NO_UPDATE=1",[131,545,547],{"id":546},"uninstall","Uninstall",[136,549,551],{"className":138,"code":550,"language":140,"meta":141,"style":141},"onlinesim mcp autostart uninstall    # if you enabled autostart\nonlinesim logout                     # remove the stored key\nrm ~\u002F.local\u002Fbin\u002Fonlinesim\n",[56,552,553,568,578],{"__ignoreMap":141},[145,554,555,557,559,562,565],{"class":147,"line":12},[145,556,58],{"class":150},[145,558,521],{"class":154},[145,560,561],{"class":154}," autostart",[145,563,564],{"class":154}," uninstall",[145,566,567],{"class":416},"    # if you enabled autostart\n",[145,569,570,572,575],{"class":147,"line":17},[145,571,58],{"class":150},[145,573,574],{"class":154}," logout",[145,576,577],{"class":416},"                     # remove the stored key\n",[145,579,580,583],{"class":147,"line":22},[145,581,582],{"class":150},"rm",[145,584,585],{"class":154}," ~\u002F.local\u002Fbin\u002Fonlinesim\n",[44,587,588,589,592,593,466],{},"On Windows delete ",[56,590,591],{},"%LOCALAPPDATA%\\onlinesim\\bin\\onlinesim.exe",". The config file location is printed by\n",[56,594,595],{},"onlinesim config path",[597,598,599],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decorat