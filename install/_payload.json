_64-pc-windows-msvc",[56,128,129],{},"aarch64-pc-windows-msvc",[131,132,134],"h2",{"id":133},"macos-and-linux","macOS and Linux",[136,137,142],"pre",{"className":138,"code":139,"language":140,"meta":141,"style":141},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -fsSL https:\u002F\u002Fraw.githubusercontent.com\u002Fon-org\u002Fonlinesim-mcp\u002Fmaster\u002Finstall.sh | sh\n","bash","",[56,143,144],{"__ignoreMap":141},[145,146,148,152,156,159,163],"span",{"class":147,"line":12},"line",[145,149,151],{"class":150},"sBMFI","curl",[145,153,155],{"class":154},"sfazB"," -fsSL",[145,157,158],{"class":154}," https:\u002F\u002Fraw.githubusercontent.com\u002Fon-org\u002Fonlinesim-mcp\u002Fmaster\u002Finstall.sh",[145,160,162],{"class":161},"sMK4o"," |",[145,164,165],{"class":150}," sh\n",[44,167,168,169,172,173,176,177,180],{},"The script downloads the latest release for your OS and CPU into ",[56,170,171],{},"~\u002F.local\u002Fbin\u002Fonlinesim",". On macOS it ad-hoc signs\nthe binary so Gatekeeper lets it run. If ",[56,174,175],{},"~\u002F.local\u002Fbin"," is not on ",[56,178,179],{},"PATH",", it prints the line to add.",[61,182,183,196],{},[64,184,185],{},[67,186,187,190,193],{},[70,188,189],{},"Variable",[70,191,192],{},"Default",[70,194,195],{},"Meaning",[77,197,198,212,229],{},[67,199,200,205,209],{},[82,201,202],{},[56,203,204],{},"ONLINESIM_INSTALL_DIR",[82,206,207],{},[56,208,175],{},[82,210,211],{},"Where to put the binary.",[67,213,214,219,223],{},[82,215,216],{},[56,217,218],{},"ONLINESIM_LIBC",[82,220,221],{},[56,222,111],{},[82,224,225,226,228],{},"Linux only: ",[56,227,115],{}," for a fully static binary (Alpine, old glibc).",[67,230,231,236,241],{},[82,232,233],{},[56,234,235],{},"ONLINESIM_MCP_REPO",[82,237,238],{},[56,239,240],{},"on-org\u002Fonlinesim-mcp",[82,242,243],{},"Repository to download from.",[136,245,247],{"className":138,"code":246,"language":140,"meta":141,"style":141},"curl -fsSL htt