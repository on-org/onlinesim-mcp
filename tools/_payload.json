ver invent them — take them from catalog tools or\n",[48,87,88],{},"list_sms_orders",".",[44,91,92,93,73,96,99,100,103],{},"Bulk tools take ",[48,94,95],{},"orderIds",[48,97,98],{},"receiptIds",": 1–20 ids (duplicates are dropped), or omit \u002F ",[48,101,102],{},"[]"," for every active one.\nCancel-all only when the user explicitly asks to close everything. One bulk call, never one call per number.",[105,106,108],"h2",{"id":107},"agent-flows","Agent flows",[44,110,111],{},"Quick SMS:",[113,114,120],"pre",{"className":115,"code":117,"language":118,"meta":119},[116],"language-text","get_account_balance\n→ search_sms_services → find_cheapest_sms_countries   (or get_sms_service_countries)\n→ order_sms_verification(serviceId, countryId)\n→ the user enters the number on the target site and requests the SMS\n→ wait_sms_verification(orderId)                       (or check_sms_verification every 15–30 s)\n→ cancel_sms_verification(orderIds)\n","text","",[48,121,117],{"__ignoreMap":119},[44,123,124],{},"Rent:",[113,126,129],{"className":127,"code":128,"language":118,"meta":119},[116],"list_sms_rentals → rent_sms_number(rentalId, days)\n→ get_sms_rental_messages(receiptIds)                  (every 15–30 s)\n→ extend_sms_rental(receiptId, days) \u002F cancel_sms_rental(receiptIds)\n",[48,130,128],{"__ignoreMap":119},[132,133,134,150],"table",{},[135,136,137],"thead",{},[138,139,140,144,147],"tr",{},[141,142,143],"th",{},"Tool",[141,145,146],{},"Kind",[141,148,149],{},"Spends",[151,152,153,171,185,199,213,227,242,258,272,286,301,315,331,345,360],"tbody",{},[138,154,155,165,168],{},[156,157,158],"td",{},[159,160,162],"a",{"href":161},"#search_sms_services",[48,163,164],{},"search_sms_services",[156,166,167],{},"catalog",[156,169,170],{},"—",[138,172,173,181,183],{},[156,174,175],{},[159,176,178],{"href":177},"#get_sms_service_countries",[48,179,180],{},"get_sms_service_countries",[156,182,167],{},[156,184,170],{},[138,186,187,195,197],{},[156,188,189],{},[159,190,192],{"href":